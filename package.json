{
  "name": "xahau-name",
  "version": "0.3.1",
  "private": true,
  "description": "Native name service on Xahau",
  "license": "MIT",
  "homepage": "https://github.com/XRPDomains/XahauName",
  "repository": {
    "type": "git",
    "url": "https://github.com/XRPDomains/XahauName.git"
  },
  "scripts": {
    "hook:build": "node scripts/build-hooks.mjs",
    "hook:test": "node scripts/test-hooks.mjs",
    "hook:check-deploy": "node hook/test/deployment.cjs",
    "sdk:build": "npm run build --workspace @xahauname/sdk",
    "sdk:test": "npm test --workspace @xahauname/sdk",
    "indexer:build": "npm run sdk:build && npm run build --workspace @xahauname/indexer",
    "indexer:test": "npm run sdk:build && npm test --workspace @xahauname/indexer",
    "indexer:start": "npm start --workspace @xahauname/indexer",
    "app:dev": "npm run dev --workspace xahauname-test-app",
    "app:test": "npm test --workspace xahauname-test-app",
    "check": "node scripts/check-repository.mjs",
    "app:typecheck": "npm run typecheck --workspace xahauname-test-app",
    "packages:build": "node scripts/check-packages.mjs --build-only",
    "packages:test": "npm run packages:build && npm test --workspace packages --if-present",
    "release:check": "node scripts/check-packages.mjs",
    "release:version": "node scripts/version-packages.mjs",
    "repo:test": "node --test scripts/test/*.test.cjs",
    "explorer:prepare": "node scripts/explorer/prepare.mjs",
    "explorer:build": "node scripts/explorer/build.mjs",
    "explorer:test": "node --test scripts/explorer/*.test.mjs"
  },
  "workspaces": [
    "packages/*",
    "test-app"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "xahau": "4.2.0"
  }
}

# Public network/deployment configuration, never wallet seeds.
XAHAU_NETWORK=testnet
# Mainnet: set XAHAU_NETWORK=mainnet and supply a reviewed SDK-shaped manifest.
# XAHAU_DEPLOYMENT_FILE=/absolute/path/to/mainnet-client.json
# XAHAU_WSS=wss://your-archival-node.example
# XAHAU_INDEX_DB=/absolute/path/to/testnet.sqlite
# Explicit first-run snapshot scan. Remove after bootstrap.
# XAHAU_INDEX_BOOTSTRAP=1
# Optional snapshot-only HTTP service for offline tests/maintenance; no live sync:
# XAHAU_INDEX_SYNC=0
PORT=8787

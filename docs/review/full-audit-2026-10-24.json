  "findings": [
    {
      "id": "OCR2-01",
      "path": "packages/sdk/src/index.ts",
      "start_line": 232,
      "severity": "medium",
      "category": "performance",
      "status": "open; previously proposed, now reproduced",
      "content": "readState caches entries even with cacheTtlMs=0 and never evicts expired keys; long-lived clients retain distinct state/ledger keys until clearCache.",
      "evidence": "Controlled SDK repro retained 2000 expired entries at TTL 0.",
      "recommendation": "Skip insertion when TTL is zero; add bounded LRU/expiry eviction and explicit snapshot-cache budgets.",
      "repairStatus": "implemented-and-regression-tested",
      "repairReport": "docs/review/AUDIT-REPAIRS-2026-10-24.md"
    },
    {
      "id": "OCR2-02",
      "path": "packages/sdk/src/index.ts",
      "start_line": 235,
      "severity": "medium",
      "category": "bug",
      "status": "open; newly reproduced",
      "content": "clearCache clears the map but does not invalidate reads already awaiting RPC. Such a read can repopulate a moving-validated cache entry with pre-invalidation data after a confirmed write or signer switch.",
      "evidence": "Pause a read, clearCache, release its old RPC response: cache size becomes 1 again.",
      "recommendation": "Use a cache generation/epoch and only populate if the request generation is still current; keep immutable-hash sharing distinct.",
      "repairStatus": "implemented-and-regression-tested",
      "repairReport": "docs/review/AUDIT-REPAIRS-2026-10-24.md"
    },
    {
      "id": "OCR2-03",
      "path": "packages/sdk/src/confirmation.ts",
      "start_line": 8,
      "severity": "medium",
      "category": "bug",
      "status": "open; newly reproduced",
      "content": "waitValidated checks its deadline only around an awaited request. A slow/stalled RPC can exceed the requested timeout, blocking confirmation progress and the UI action lock.",
      "evidence": "A request that never resolves leaves timeoutMs=5 unsettled after 40 ms.",
      "recommendation": "Bound each read by remaining deadline, validate timing options, retain txHash and preserve the no-resubmit rule; add cancellation without cancelling other shared consumers.",
      "repairStatus": "implemented-and-regression-tested",
      "repairReport": "docs/review/AUDIT-REPAIRS-2026-10-24.md"
    },
    {
      "id": "OCR2-04",
      "path": "packages/indexer/src/index.ts",
      "start_line": 61,
      "severity": "medium",
      "category": "performance",
      "status": "open; documented scale limit, now quantified",
      "content": "Every ledger clones the full materialized state; each relevant receipt spreads all profiles and projects every known name twice. Work scales with total indexed domains rather than changed domains.",
      "evidence": "100 valid domains plus one profile update invoked projectDomain 200 times.",
      "recommendation": "Maintain state-key/token/owner dependencies, project only affected domains and commit a copy-on-write change set; move large read models to indexed storage.",
      "repairStatus": "implemented-and-regression-tested",
      "repairReport": "docs/review/AUDIT-REPAIRS-2026-10-24.md"
    },
    {
      "id": "OCR2-05",
      "path": "packages/indexer/src/storage.ts",
      "start_line": 47,
      "severity": "medium",
      "category": "performance",
      "status": "open; newly quantified retention behavior",
      "content": "applyLedger commits all full-chain receipts and SQLite retains them indefinitely, including traffic with no domain changes/events. Disk growth and write load track the whole network.",
      "evidence": "100 unrelated Payments produced 0 business events but 100 stored receipts.",
      "recommendation": "Decode all ordered transactions for completeness, persist relevant receipts plus ledger/checkpoint evidence, and make full archival retention/compression/pruning an explicit option.",
      "repairStatus": "implemented-and-regression-tested",
      "repairReport": "docs/review/AUDIT-REPAIRS-2026-10-24.md"
    },
    {
      "id": "OCR2-06",
      "path": "packages/sdk/src/registrar.ts",
      "start_line": 244,
      "severity": "medium",
      "category": "performance",
      "status": "open; source-confirmed",
      "content": "Incoming offers rescan account history up to 100 pages on every refresh and verify candidates serially without a shared snapshot context. Primary discovery separately enumerates all owned tokens. Large histories/portfolios create many dependent RPC round trips.",
      "evidence": "Source tracing: history loop at 244, sequential candidate loop at 268 and primary enumeration in resolver.ts:147.",
      "recommendation": "Offer paginated/incremental collection reads, share pinned identity results and use bounded candidate concurrency; integrate an explicit indexer read source with history-completeness metadata.",
      "repairStatus": "implemented-and-regression-tested",
      "repairReport": "docs/review/AUDIT-REPAIRS-2026-10-24.md"
    },
    {
      "id": "OCR2-07",
      "path": "packages/sdk/src/resolver.ts",
      "start_line": 229,
      "severity": "medium",
      "category": "performance",
      "status": "open; previously identified read-planning issue",
      "content": "Selective describe still enumerates the records index/custom slots; requested values then use unbounded Promise.all. Explicit caller arrays are not constrained to the on-chain inventory size.",
      "evidence": "describeSnapshot always calls getRecordKeys before selected reads; mapReads only bounds descriptor/portfolio work.",
      "recommendation": "Implement a shared verified read planner/getRecords facade; bypass enumeration for explicit selections, deduplicate keys, bound aggregate concurrency and report selection completeness accurately.",
      "repairStatus": "implemented-and-regression-tested",
      "repairReport": "docs/review/AUDIT-REPAIRS-2026-10-24.md"
    },
    {
      "id": "OCR2-08",
      "path": "test-app/src/app.ts",
      "start_line": 43,
      "severity": "medium",
      "category": "performance",
      "status": "open; newly reproduced",
      "content": "Activity renders only 30 entries but retains every activity item and receipt/details object in memory for the entire page session.",
      "evidence": "Executing the actual transpiled log function 1000 times retained 1000 entries while the display remained limited to 30.",
      "recommendation": "Bound activity/history by item and byte budgets, keep compact summaries and fetch full receipt details by hash on demand.",
      "repairStatus": "implemented-and-regression-tested",
      "repairReport": "docs/review/AUDIT-REPAIRS-2026-10-24.md"
    }
  ],

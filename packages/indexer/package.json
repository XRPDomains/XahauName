{
  "name": "@xahauname/indexer",
  "version": "0.4.0",
  "description": "Validated-ledger replay, SQLite projection and event outbox for XahauName",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XRPDomains/XahauName.git",
    "directory": "packages/indexer"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "examples",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.cjs",
    "start": "node examples/server.cjs",
    "test:testnet": "node test/testnet.cjs",
    "prepack": "npm run build",
    "test:unit": "node --test test/*.test.cjs"
  },
  "peerDependencies": {
    "@xahauname/sdk": "^0.4.0"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "xahau": "4.2.0"
  },
  "devDependencies": {
    "@xahauname/sdk": "0.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

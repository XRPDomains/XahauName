{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@xahauname/sdk": [
        "../sdk/src/index.ts"
      ]
    },
    "resolvePackageJsonExports": false
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}

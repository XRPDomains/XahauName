# Optional PUBLIC Xaman OAuth client ID. Never put a seed or private key here.
VITE_XAMAN_CLIENT_ID=1c7dfba7-aadd-4b03-bafb-ca5c8f84bb4f
# Shared SDK network preset: testnet or mainnet. Mainnet requires its own deployment.
VITE_NETWORK=testnet
# VITE_WSS=wss://your-archival-node.example
# Required for mainnet, optional for a custom testnet deployment (all public values):
# VITE_DEPLOYMENT_JSON={"treasury":"<mainnet treasury>","namespaceId":"<64 hex>","expectedNetworkId":21337,"hookHashes":{"issuance":"<64 hex>","claim":"<64 hex>"}}
# Optional when hosting outside xrpdomains.xyz: configure a matching server proxy.
# VITE_METADATA_PROXY_BASE=/__metadata

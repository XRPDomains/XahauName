{
  "name": "xahauname-test-app",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --tsconfig tsconfig.test.json --test tests/*.test.ts",
    "test:browser": "node --import tsx tests/browser-smoke.cjs",
    "test:screenshots": "node --import tsx tests/browser-smoke.cjs --screenshots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xahauname/sdk": "0.4.0",
    "@xrpl-wallet-kit/client": "0.3.2",
    "buffer": "6.0.3",
    "xahau": "4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "marked": "18.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.1"
  }
}
